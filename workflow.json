{
  "name": "Slack Recipe Bot",
  "nodes": [
    {
      "parameters": { "trigger": ["app_mention"], "channelId": "" },
      "id": "b1b2c3d4-0001-4000-8000-000000000001",
      "name": "Slack Trigger",
      "type": "n8n-nodes-base.slackTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "credentials": { "slackApi": { "id": "", "name": "Slack account" } }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "recipe", "value": "={{ $json.text }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000002",
      "name": "Capture Recipe Name",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "user",
              "content": "=List all the products and ingredients needed to make {{ $json.recipe }}.\nReturn a clear bulleted list with approximate quantities.\nKeep it short and practical. If the recipe name is unclear, ask the user to rephrase it."
            }
          ]
        }
      },
      "id": "b1b2c3d4-0003-4000-8000-000000000003",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [680, 300]
    },
    {
      "parameters": {
        "modelName": "gpt-4o-mini",
        "options": {}
      },
      "id": "b1b2c3d4-0004-4000-8000-000000000004",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [680, 520],
      "credentials": { "openAiApi": { "id": "", "name": "OpenAi account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Format the AI answer neatly for Slack\nconst answer = ($json.text || $json.output || '').trim();\nconst recipe = $('Capture Recipe Name').first().json.recipe;\nitem.json.slackText = `*${recipe}*\n\n${answer}`;\nreturn item;"
      },
      "id": "b1b2c3d4-0005-4000-8000-000000000005",
      "name": "Format for Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "fromSearch", "value": "" },
        "text": "={{ $json.slackText }}",
        "otherOptions": {}
      },
      "id": "b1b2c3d4-0006-4000-8000-000000000006",
      "name": "Reply in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1120, 300],
      "credentials": { "slackApi": { "id": "", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Slack Trigger": { "main": [[{ "node": "Capture Recipe Name", "type": "main", "index": 0 }]] },
    "Capture Recipe Name": { "main": [[{ "node": "Basic LLM Chain", "type": "main", "index": 0 }]] },
    "Basic LLM Chain": { "main": [[{ "node": "Format for Slack", "type": "main", "index": 0 }]] },
    "OpenAI Chat Model": { "ai_languageModel": [[{ "node": "Basic LLM Chain", "type": "ai_languageModel", "index": 0 }]] },
    "Format for Slack": { "main": [[{ "node": "Reply in Slack", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {}
}
